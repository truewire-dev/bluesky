{
  "name": "@truewire/bluesky",
  "version": "0.1.0",
  "description": "Typed, validated TypeScript client for Bluesky's public API and the Jetstream firehose, generated by Truewire.",
  "keywords": [
    "truewire",
    "bluesky",
    "atproto",
    "at-protocol",
    "jetstream",
    "firehose",
    "api-client",
    "typescript",
    "validation"
  ],
  "homepage": "https://github.com/truewire-dev/bluesky#readme",
  "bugs": "https://github.com/truewire-dev/bluesky/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/truewire-dev/bluesky.git",
    "directory": "packages/typescript"
  },
  "license": "MIT",
  "author": "Truewire",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./generated": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@truewire/core": "^0.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
